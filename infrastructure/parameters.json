{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "baseName": {"value": "<UNIQUE_APP_PREFIX>"},
    "postgresAdminLogin": {"value": "bootstrapadmin"},
    "productionDatabaseName": {"value": "taskdb_production"},
    "stagingDatabaseName": {"value": "taskdb_staging"},
    "demoDatabaseName": {"value": "taskdb_demo"},
    "postgresAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/<VAULT_RG>/providers/Microsoft.KeyVault/vaults/<ADMIN_VAULT>"
        },
        "secretName": "postgres-bootstrap-admin"
      }
    },
    "productionDatabaseSecretUri": {
      "value": "https://<PRODUCTION_VAULT>.vault.azure.net/secrets/runtime-database-url/<VERSION>"
    },
    "stagingDatabaseSecretUri": {
      "value": "https://<STAGING_VAULT>.vault.azure.net/secrets/runtime-database-url/<VERSION>"
    },
    "enableDemoSlot": {"value": false},
    "demoDatabaseSecretUri": {"value": ""},
    "enableDemoAlerts": {"value": false},
    "alertEmailAddress": {"value": ""},
    "enableSreAgent": {"value": false},
    "sreAgentLocation": {"value": "eastus2"},
    "sreAgentModelName": {"value": ""},
    "sreAgentModelProvider": {"value": ""},
    "sreAgentConsentReference": {"value": ""},
    "grantSreInvestigationRoles": {"value": false}
  }
}
